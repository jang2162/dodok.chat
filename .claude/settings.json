{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/orca-worker-check.sh UserPromptSubmit",
            "timeout": 15,
            "statusMessage": "Orca 워커 현황 확인"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/orca-worker-check.sh SessionStart",
            "timeout": 15,
            "statusMessage": "Orca 워커 현황 확인"
          }
        ]
      }
    ]
  }
}
