# 스파이크 1(Gateway 클라이언트)이 쓰는 변수. 전체 목록은 docs/project-structure.md 4장.
# 실제 값은 .env 에만 둔다 — .env 와 data/ 는 커밋하지 않는다.

OPENCLAW_GATEWAY_URL=wss://gateway.example.com
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_DEVICE_IDENTITY_PATH=./data/openclaw-device.json

# 스파이크 2(채널 플러그인) — 로컬 dev Gateway(`openclaw --dev gateway run`)와 브리지. 원격 Gateway 변수와 따로 둔다.
OPENCLAW_DEV_GATEWAY_URL=ws://127.0.0.1:19001
OPENCLAW_DEV_GATEWAY_TOKEN=
# 플러그인이 붙을 우리 서버(브리지). 플러그인 계정 설정의 bridgeUrl 은 여기에 /bridge(네임스페이스)를 붙인 값
BRIDGE_URL=ws://127.0.0.1:19100
BRIDGE_TOKEN=
