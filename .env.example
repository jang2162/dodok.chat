# dodok 서버(apps/server) 설정 — 스펙 docs/superpowers/specs/2026-09-15-server-core-design.md 3.1. 전체 목록은 docs/project-structure.md 4장.
# 실제 값은 .env 에만 둔다 — .env 와 data/ 는 커밋하지 않는다. 빈 값(KEY=)은 설정하지 않은 것으로 보고 기본값을 쓴다.
# 서버는 저장소 루트를 작업 디렉터리로 삼고 루트의 .env 를 읽는다(상대 경로도 루트 기준).

# ── 서버 ──
# 리슨 주소 (기본 127.0.0.1)
HOST=
# 리슨 포트 (기본 3000)
PORT=
# 웹 앱 오리진 — 쿠키·CORS 기준 (필수, 로컬 예: http://localhost:5173)
APP_ORIGIN=
# 리버스 프록시 뒤에서 X-Forwarded-For 를 믿을지 true|false — 로그인 레이트리밋이 클라이언트 IP 로 걸린다 (기본 false)
TRUST_PROXY=
# 런타임 데이터 디렉터리 — DB·디바이스 아이덴티티가 여기 생긴다 (기본 ./data)
DATA_DIR=
# SQLite 파일 경로 (기본 <DATA_DIR>/dodok.sqlite)
DB_PATH=
# 로그 수준 fatal|error|warn|info|debug|trace (기본 info)
LOG_LEVEL=
# 부팅 때 워크스페이스가 없으면 이 이름으로 하나 만든다 (기본 dodok)
DODOK_WORKSPACE_NAME=

# ── 인증 ──
# owner 핸들, 소문자·숫자·_- 2~32자 (기본 owner)
OWNER_HANDLE=
# 로컬 로그인 토큰 = owner 의 Better Auth 비밀번호 (필수, 16자 이상)
LOCAL_AUTH_TOKEN=
# Better Auth 서명 비밀 (필수, 32자 이상)
BETTER_AUTH_SECRET=

# ── OpenClaw Gateway ──
# 어댑터가 붙을 Gateway: remote(기본) | dev. 고른 쪽의 URL·TOKEN 쌍이 있어야 부팅한다
OPENCLAW_TARGET=
# 원격 Gateway (OPENCLAW_TARGET=remote). 예: wss://gateway.example.com
OPENCLAW_GATEWAY_URL=
OPENCLAW_GATEWAY_TOKEN=
# 로컬 dev Gateway (OPENCLAW_TARGET=dev, `openclaw --dev gateway run`, docs/guides/live-smoke.md). 원격 변수와 따로 둔다. 예: ws://127.0.0.1:19001
OPENCLAW_DEV_GATEWAY_URL=
OPENCLAW_DEV_GATEWAY_TOKEN=
# 디바이스 아이덴티티 파일 (기본 <DATA_DIR>/openclaw-device.json, dev 대상은 openclaw-device-dev.json — 페어링이 섞이지 않게)
OPENCLAW_DEVICE_IDENTITY_PATH=

# ── 브리지 (플러그인 → 서버 /bridge) ──
# 플러그인 계정 설정에 넣을 공유 토큰 (필수, 16자 이상)
BRIDGE_TOKEN=
# 플러그인 계정 설정의 bridgeUrl 에 적을 공개 주소(정보용 — 서버는 이 값으로 리슨하지 않는다). 예: wss://dodok.example.com/bridge
BRIDGE_PUBLIC_URL=

# ── 스파이크 러너 전용 (서버는 읽지 않는다) ──
# packages/openclaw-adapter/src/spike/* 러너가 브리지를 리슨할 오리진(/bridge 없음). 서버는 HOST·PORT 에서 /bridge 를 연다. 예: ws://127.0.0.1:19100
BRIDGE_URL=
