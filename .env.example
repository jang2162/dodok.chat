# dodok 서버(apps/server) 설정 — 스펙 docs/superpowers/specs/2026-09-15-server-core-design.md 3.1. 전체 목록은 docs/project-structure.md 4장.
# 실제 값은 .env 에만 둔다 — .env 와 data/ 는 커밋하지 않는다. 빈 값(KEY=)은 설정하지 않은 것으로 보고 기본값을 쓴다.
# 서버는 저장소 루트를 작업 디렉터리로 삼고 루트의 .env 를 읽는다(상대 경로도 루트 기준).

# ── 서버 ──
# 리슨 주소 (기본 127.0.0.1)
HOST=
# 리슨 포트 (기본 3000)
PORT=
# 웹 앱 오리진 — 쿠키·CORS 기준 (필수, 로컬 예: http://localhost:5173)
APP_ORIGIN=
# 리버스 프록시 뒤에서 X-Forwarded-For 를 믿을지 true|false — 로그인 레이트리밋이 클라이언트 IP 로 걸린다 (기본 false)
TRUST_PROXY=
# 런타임 데이터 디렉터리 — DB·첨부 블롭·디바이스 아이덴티티가 여기 생긴다 (기본 ./data)
DATA_DIR=
# SQLite 파일 경로 (기본 <DATA_DIR>/dodok.sqlite)
DB_PATH=
# 첨부 블롭 디렉터리 (기본 <DATA_DIR>/attachments) — 부팅 때 만든다. 한 서버 프로세스만 쓴다
ATTACHMENTS_DIR=
# 로그 수준 fatal|error|warn|info|debug|trace (기본 info)
LOG_LEVEL=
# 부팅 때 워크스페이스가 없으면 이 이름으로 하나 만든다 (기본 dodok)
DODOK_WORKSPACE_NAME=

# ── 인증 ──
# owner 핸들, 소문자·숫자·_- 2~32자 (기본 owner)
OWNER_HANDLE=
# 로컬 로그인 토큰 = owner 의 Better Auth 비밀번호 (필수, 16자 이상)
LOCAL_AUTH_TOKEN=
# Better Auth 서명 비밀 (필수, 32자 이상)
BETTER_AUTH_SECRET=

# ── OpenClaw Gateway ──
# 어댑터가 붙을 Gateway: remote(기본) | dev. 고른 쪽의 URL·TOKEN 쌍이 있어야 부팅한다
OPENCLAW_TARGET=
# 원격 Gateway (OPENCLAW_TARGET=remote). 예: wss://gateway.example.com
OPENCLAW_GATEWAY_URL=
OPENCLAW_GATEWAY_TOKEN=
# 로컬 dev Gateway (OPENCLAW_TARGET=dev, `openclaw --dev gateway run`, docs/guides/live-smoke.md). 원격 변수와 따로 둔다. 예: ws://127.0.0.1:19001
OPENCLAW_DEV_GATEWAY_URL=
OPENCLAW_DEV_GATEWAY_TOKEN=
# 서버가 더 읽지 않는다(값이 있어도 무시) — 디바이스 아이덴티티·토큰은 Gateway 마다 DATA_DIR/gateways/<연결 id>/ (.env 의 Gateway 는 연결 id env). 이 줄은 Gateway 를 DB 로 옮기는 태스크가 지운다
OPENCLAW_DEVICE_IDENTITY_PATH=
# 진단용(선택) — 어댑터가 받은 Gateway chat·agent·session.message 프레임을 Gateway 연결마다 <이 경로>.<연결 id> 파일에 JSONL 로 append 한다(.env 의 Gateway 는 연결 id env). 본문이 들어가므로 data/ 아래에. 예: data/frames.jsonl → data/frames.jsonl.env
OPENCLAW_FRAME_DUMP_PATH=

# ── 브리지 (플러그인 → 서버 /bridge) ──
# 선택(있으면 16자 이상) — 새로 만들면 비워 둔다. 브리지 토큰은 웹 연결 페이지(/settings/connection)에서 발급하고 DB 에 해시만 둔다.
# 이 값은 부팅 때 토큰 행이 하나도 없으면(폐기된 행 포함) 라벨 env 로 한 번 이어받을 뿐이다 — 그 뒤 여기를 바꿔도 통하지 않는다(교체는 연결 페이지)
BRIDGE_TOKEN=
# 플러그인 계정 설정의 bridgeUrl — 연결 페이지가 보여 주고 발급한 설정 조각에 들어간다(서버는 이 값으로 리슨하지 않는다).
# 비우면 APP_ORIGIN 의 https:→wss:(http:→ws:) + /bridge. 예: wss://dodok.example.com/bridge
BRIDGE_PUBLIC_URL=

# ── 웹 푸시 (VAPID) ──
# 키 쌍 — 둘 다 있어야 쓴다. 없으면 <DATA_DIR>/vapid.json 을 만들어(0600) 쓴다. 키가 바뀌면 모든 기기의 푸시 구독이 무효가 된다
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 푸시 서비스가 연락할 주체, mailto: 또는 https: (기본 mailto:dodok@localhost — 개발용). 호스트가 localhost·127.0.0.1·*.local 이면
# Apple Push(Safari·iOS)가 403 BadJwtToken 으로 거부한다 — 실기기로 보내는 배포는 실제 연락처로. 예: mailto:ops@example.com
VAPID_SUBJECT=

# ── 배포 (Docker Compose — infra/compose.yml, 배포 호스트의 이 파일) ──
# 운영 번들은 이 파일을 직접 읽지 않는다 — compose 가 env_file 로 컨테이너 환경변수로 넘긴다.
# 배포 값: APP_ORIGIN=https://<도메인> · TRUST_PROXY=true(Caddy 뒤) · VAPID_SUBJECT 는 실제 연락처. BRIDGE_PUBLIC_URL 은 비워도 APP_ORIGIN 에서 wss://<도메인>/bridge 가 된다.
# HOST·PORT·DATA_DIR·DODOK_MIGRATIONS_DIR·DODOK_PLUGIN_DIR 는 compose 가 컨테이너 값(0.0.0.0·3000·/data·/app/drizzle·/app/plugin)으로 고정한다 — 여기 적어도 무시된다
# Caddy 가 인증서를 받을 공개 도메인 (배포 필수). compose 가 변수 치환으로 읽으므로 배포 호스트에서 한 번 `ln -s ../.env infra/.env`
DODOK_DOMAIN=

# ── 스파이크 러너 전용 (서버는 읽지 않는다) ──
# packages/openclaw-adapter/src/spike/* 러너가 브리지를 리슨할 오리진(/bridge 없음). 서버는 HOST·PORT 에서 /bridge 를 연다. 예: ws://127.0.0.1:19100
BRIDGE_URL=
