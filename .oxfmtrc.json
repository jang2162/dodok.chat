{
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 110,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "ignorePatterns": [
    "**/dist",
    "**/drizzle/meta",
    "**/*.sql",
    "**/*.md",
    "pnpm-lock.yaml",
    "**/data/**",
    ".worktrees/**",
    ".claude/settings.local.json"
  ]
}
