# dodok 공개 오리진(스펙 2.3) — 정적 웹·서버 프록시·보안 헤더·본문 상한. 검증: infra/check-caddy.sh
# 환경변수(compose 가 넘긴다) — Caddy 는 {$VAR} 를 설정을 읽을 때 글자 그대로 치환한다(전역 블록 안에서도)
#   DODOK_DOMAIN       인증서를 받을 도메인(필수 — 프록시 뒤면 인증서 없이 Host 를 맞추는 이름으로만 쓴다). 로컬 검증은 localhost
#   CADDY_LOCAL_CERTS  로컬 검증만 local_certs — 공개 CA 대신 Caddy 내부 CA. 운영은 비워 둔다(빈 전역 블록)
#   DODOK_UPSTREAM     서버 주소(기본 app:3000). 로컬 검증의 devfake 프로필만 devfake:3000
#   기존 리버스 프록시 뒤에 둘 때만(서버 덮어쓰기 파일이 켠다 — 바깥 프록시가 컨테이너면 compose.server.example.yml, 호스트 프로세스면 deploy.md
#   「바깥 프록시가 호스트에 깔린 경우」의 조각. 비우면 지금처럼 Caddy 가 공개 앞단):
#   DODOK_SITE_SCHEME      http:// 면 HTTP(:80)만 듣고 인증서를 받지 않는다. 사이트 주소는 이 값 + DODOK_DOMAIN 이라 바깥 프록시가
#                          Host 를 그 도메인으로 넘겨야 맞는다. {$A:{$B}} 처럼 기본값 안에 변수를 넣는 꼴은 Caddy 2.11.4 가 풀지 않아
#                          (caddy adapt 가 '{$B}' 를 글자로 남긴다) 주소 전체가 아니라 접두만 손잡이로 둔다
#   DODOK_TRUSTED_PROXIES  바깥 프록시가 이 Caddy 에 닿는 주소(CIDR, 공백으로 여럿 — 서브넷 전체가 아니라 프록시 주소만인 까닭은
#                          compose.server.example.yml, 호스트 프록시면 게이트웨이 /32 — deploy.md 「바깥 프록시가 호스트에 깔린 경우」).
#                          비우면 아무도 믿지 않는다(빈 목록도 파싱된다)
{
	{$CADDY_LOCAL_CERTS}
	# 클라이언트 IP — 레이트리밋·브리지 실패 카운터가 이 값으로 걸린다(서버는 TRUST_PROXY=true 로 X-Forwarded-For 첫 값을 읽는다).
	# 믿는 프록시가 보낸 XFF 만 오른쪽부터 읽어 믿는 주소를 건너뛴 첫 주소를 client_ip 로 삼고(strict), 아래 reverse_proxy 가 XFF 를
	# 그 값 하나로 덮는다. 덮지 않으면 Caddy 는 믿는 프록시의 XFF 뒤에 덧붙이기만 해, 클라이언트가 꾸민 가장 왼쪽 값이 서버에 닿아
	# 레이트리밋을 우회한다(바깥 프록시는 대개 받은 XFF 에 덧붙인다). 아무도 믿지 않으면 client_ip 는 연결 주소다
	servers {
		trusted_proxies static {$DODOK_TRUSTED_PROXIES}
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
	# 웹훅 토큰을 로그에서 가린다 — access log 는 없지만 핸들러 오류(http.log.error)가 기본 로거로 request.uri 를 원문으로 남긴다:
	# 업스트림이 내려간 동안(배포·재시작)이나 보낸 쪽이 본문 도중 끊을 때의 502. 업스트림이 응답 도중 끊으면 reverse_proxy 로거의
	# 「aborting with incomplete response」 경고도 request.uri 를 싣는다 — 같은 기본 로그라 이 필터가 함께 가린다.
	# 꼴은 서버 redactUrl(apps/server/src/logger.ts)과 같다 — /hooks/ 다음 조각(대소문자 무관)은 앞 10자, 그 밖 어디든 whk_ 토큰
	# 꼴은 whk_ + 6자 뒤를 「…」로, 개인 토큰 dpt_ 꼴(/mcp 는 Authorization 머리로만 받지만 ?token= 으로 잘못 실려 올 수 있다)도
	# dpt_ + 6자 뒤를 「…」로. 필드 하나에 필터 하나라 세 규칙을 교대로 합쳤다(맞지 않은 쪽 그룹은 빈 글).
	# 확인: infra/check-caddy.sh 의 CADDY_LOG_CMD(탐침 넷이 세 규칙을 따로 잰다)
	log default {
		format filter {
			request>uri regexp "((?i:/hooks/)[^/?#]{10})[^/?#]+|(whk_[\w-]{6})[\w-]+|(dpt_[\w-]{6})[\w-]+" "${1}${2}${3}…"
		}
	}
}

{$DODOK_SITE_SCHEME}{$DODOK_DOMAIN} {
	encode zstd gzip
	# 첨부 20 MiB + multipart 여유 — 서버 상한보다 커야 넘친 업로드에 Caddy 413 대신 서버의 고정 문구가 나간다
	request_body {
		max_size 32MB
	}

	# /bridge/*·/runner/* 는 플러그인·러너의 첨부 HTTP(/bridge/attachments·/runner/attachments) — 두 WebSocket 은
	# /socket.io/ 의 /bridge·/runner 네임스페이스다. /llms.txt 는 서버가 공개 주소를 채워 내는 노드 설치 안내서(정적 파일이 아니다).
	# /hooks/* 는 자동화 웹훅 수신(POST /hooks/<token>) — 빠지면 바깥 서비스의 POST 가 SPA 폴백으로 떨어진다.
	# /mcp 는 바깥 MCP 클라이언트의 입구(개인 토큰은 Authorization 머리로만 온다 — Caddy 로그는 그 머리를 가린다)
	@backend path /api/* /socket.io/* /bridge/* /runner/* /hooks/* /mcp /healthz /llms.txt
	handle @backend {
		reverse_proxy {$DODOK_UPSTREAM:app:3000} {
			# 서버가 받는 XFF 는 늘 주소 하나 — 까닭은 전역 servers 블록
			header_up X-Forwarded-For {client_ip}
		}
	}

	# 해시가 붙은 빌드 산출물. SPA 폴백을 주지 않는다 — 없는 청크(옛 버전을 든 탭)가 index.html 로 200 을 받아 1년 캐시되면 안 된다.
	# immutable 도 있는 파일에만(@built) — 없는 청크의 404 가 1년 캐시되면 안 되는 것은 같다
	handle /assets/* {
		root * /srv
		@built file
		header @built Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# 나머지는 매번 재검증(no-cache) — sw.js 가 캐시되면 새 버전이 영영 안 뜬다. 경로로 고르지 않고 전부에 거는 까닭: `/` 와
	# SPA 깊은 경로(/c/<id>)도 index.html 을 내는데, 경로 매처(/index.html)로는 그 둘이 빠진다
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header Strict-Transport-Security "max-age=31536000"
	header X-Content-Type-Options nosniff
	header Referrer-Policy strict-origin-when-cross-origin
	# CSP — 스크립트는 이 오리진의 파일만(인라인·eval 없음 — zod 는 웹이 jitless 로 둔다, apps/web/src/lib/zodJitless.ts).
	# 스타일만 'unsafe-inline': 라이브러리가 런타임에 <style> 을 꽂는다(Tiptap·sonner·스크롤 잠금 — 내용이 달라져 해시로 못 막는다).
	# img https: 는 components media 블록의 외부 이미지, blob: 은 작성기 첨부 미리보기, data: 는 인라인 이미지.
	# connect 'self' 가 같은 오리진의 wss(Socket.IO)도 덮는다. worker 는 /sw.js, frame-ancestors 로 다른 사이트의 틀 안에 못 넣는다
	header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
}
