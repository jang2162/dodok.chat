# 로컬 검증 전용 설정(infra/compose.local.yml) — 값은 전부 가짜다. 이 파일을 infra/local.env 로 복사해 쓴다(커밋 금지, .gitignore).
# 비어 있는 비밀 자리는 셸에서 만들어 파일로만 쓴다(화면에 찍지 않는다). 예:
#   cp infra/local.env.example infra/local.env
#   for k in LOCAL_AUTH_TOKEN BETTER_AUTH_SECRET BRIDGE_TOKEN OPENCLAW_GATEWAY_TOKEN; do
#     sed -i.bak "s/^$k=\$/$k=$(openssl rand -hex 32)/" infra/local.env; done; rm infra/local.env.bak
# 이 파일은 app 의 env_file 이면서 compose 의 --env-file(변수 치환)이다 — DODOK_DOMAIN 은 치환용

# compose.yml 의 ${DODOK_DOMAIN:?} 치환용 — Caddy 에는 compose.local.yml 이 localhost 를 따로 준다
DODOK_DOMAIN=localhost

# 웹 오리진 = Caddy 의 로컬 포트. 쿠키·wire 핸드셰이크 Origin 검사 기준이라 브라우저 주소와 같아야 한다
APP_ORIGIN=https://localhost:8443
# Caddy 뒤 — X-Forwarded-For 를 믿는다
TRUST_PROXY=true
LOG_LEVEL=info

LOCAL_AUTH_TOKEN=
BETTER_AUTH_SECRET=
BRIDGE_TOKEN=
BRIDGE_PUBLIC_URL=wss://localhost:8443/bridge

# 닿지 않는 Gateway — 부팅은 막지 않는다(어댑터가 재시도만 한다). wss 인 까닭: 루프백이 아닌 ws:// 는 Gateway 클라이언트가
# SECURITY ERROR 로 거절해 「닿지 않음」과 다른 경고가 된다. 에이전트 답까지 볼 때는 devfake 프로필(compose.local.yml 머리)
OPENCLAW_GATEWAY_URL=wss://host.invalid:9
OPENCLAW_GATEWAY_TOKEN=

VAPID_SUBJECT=mailto:local-check@example.com
