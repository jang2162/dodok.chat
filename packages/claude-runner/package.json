{
  "name": "@dodok/claude-runner",
  "version": "0.0.0",
  "private": true,
  "description": "dodok local runner — runs Claude Code agents via the Claude Agent SDK and connects to the dodok server",
  "bin": {
    "dodok-runner": "dist/main.js"
  },
  "files": [
    "dist/main.js"
  ],
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "pack:runner": "pnpm build && pnpm pack --pack-destination dist",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.283",
    "socket.io-client": "4.8.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@dodok/runner-adapter": "workspace:*",
    "@dodok/shared": "workspace:*",
    "@types/node": "^24.13.4",
    "esbuild": "0.28.2",
    "socket.io": "4.8.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
